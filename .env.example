MEDIBOT_APP_NAME=Medibot
MEDIBOT_APP_VERSION=0.1.0
MEDIBOT_ENVIRONMENT=local
MEDIBOT_POLICY_VERSION=unapproved
MEDIBOT_MAX_REQUEST_BODY_BYTES=16384
MEDIBOT_DEBUG=false
MEDIBOT_RATE_LIMIT_REQUESTS=60
MEDIBOT_RATE_LIMIT_WINDOW_SECONDS=60
MEDIBOT_VIDEO_DATABASE_PATH=data/runtime/video.sqlite3
MEDIBOT_JOB_DATABASE_PATH=data/runtime/jobs.sqlite3
MEDIBOT_DATASET_DIRECTORY=data/dataset
MEDIBOT_ARTIFACT_DIRECTORY=data/artifacts
# Required in production; replace through a secret manager, never commit the real value.
# MEDIBOT_OPERATOR_API_KEY=replace-with-secret-manager-value
